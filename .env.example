# Cala (required). Redeem your free Junction credits at https://console.cala.ai
# Billing -> Extra credits -> Add credits -> Add promo code: MAKEUNICORNSREAL
CALA_API_KEY=your_cala_api_key_here
# Optional: how long Cala answers are reused (hours, default 24). The app's
# "Ask Cala live" box skips them for one run.
CALA_CACHE_HOURS=24
# Optional: Cala requests in flight at once (default 5). Raise it only if your
# key's rate limit allows.
CALA_MAX_CONCURRENT=5
# Optional: id of a saved run (in .cache/runs) to show on the landing page.
# By default it shows the latest finished run of the built-in example.
FLIPDD_SHOWCASE_RUN=

# Gemini (optional): judges which companies really compete and words the
# meeting questions. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: pin a model. By default FlipDD picks the newest stable Flash model.
GEMINI_MODEL=
# Optional: Gemini calls in flight at once (default 6). Use 2 or 3 on a free-tier key.
GEMINI_MAX_CONCURRENT=6

# Context.dev (optional): live news for the watchlist.
# Redeem team credits with code JUNCTION26 at https://context.dev/dashboard/redeem-credits
CONTEXT_DEV_API_KEY=

# Optional: require "Authorization: Bearer <token>" on /api/mcp when deployed.
FLIPDD_MCP_TOKEN=

# Telegram bot (optional). Create a bot with @BotFather and paste its token.
# Local: `npm run telegram` (polling). Deployed: node scripts/telegram-webhook.mjs <url>
TELEGRAM_BOT_TOKEN=
# Optional: a random string Telegram sends back with each update, checked by /api/telegram.
TELEGRAM_WEBHOOK_SECRET=
# Optional: comma-separated chat ids allowed to use the bot (empty = anyone).
TELEGRAM_ALLOWED_CHATS=
# Optional: public address of the app, used for links in bot replies.
FLIPDD_PUBLIC_URL=

# Voice (uses GEMINI_API_KEY). Listen buttons and Play my day use the browser's
# own voice and need nothing. The mic in Ask Cala falls back to Gemini
# transcription on browsers without speech recognition (iPhone Safari).
# Telegram voice replies use Gemini TTS + ffmpeg (installed by nixpacks.toml).
# Optional overrides: TTS model (default: newest Flash TTS), voice name, ffmpeg path.
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE=Kore
FFMPEG_PATH=

# Phone line (optional). Buy a Twilio number and set its voice webhook
# ("A call comes in") to POST {FLIPDD_PUBLIC_URL}/api/voice/twilio, or run:
#   node scripts/twilio-number.mjs
# With TWILIO_AUTH_TOKEN set, only requests signed by Twilio are accepted.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional: comma-separated caller numbers allowed to use the line (E.164, e.g. +358401234567).
TWILIO_ALLOWED_CALLERS=
# Optional: Twilio <Say> voice (default Polly.Amy-Neural).
TWILIO_VOICE=

# Landing page "On the go" section: shown only when set.
# The Twilio number to display as a Call button (e.g. +1 415 555 0100), and the bot's @username.
FLIPDD_PHONE_NUMBER=
FLIPDD_TELEGRAM_BOT=

# ElevenLabs voice for Listen and Play my day (optional; the browser's own voice is the fallback).
ELEVENLABS_API_KEY=
# Optional: voice and model (defaults: Michael Onoja, eleven_flash_v2_5).
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
